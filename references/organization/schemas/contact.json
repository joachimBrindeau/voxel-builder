{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Brand Contact Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "contact", "location"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "contact": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canal-type", "canal-value"],
        "properties": {
          "canal-type": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {"type": "string", "enum": ["email", "facebook", "google-maps", "instagram", "linkedin", "phone", "pinterest", "reviewsio", "shopify", "telegram", "tiktok", "trustpilot", "twitter", "website", "wechat", "whatsapp", "youtube"]}
          },
          "canal-value": {"type": "string", "minLength": 1, "maxLength": 255}
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "map_picker", "latitude", "longitude"],
      "properties": {
        "address": {"type": ["string", "null"]},
        "map_picker": {"enum": [false, null]},
        "latitude": {"type": ["number", "null"]},
        "longitude": {"type": ["number", "null"]}
      }
    }
  }
}
