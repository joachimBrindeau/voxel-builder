{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Brand Foundation Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "url_slug", "metadescription", "tagline", "history-content", "history-events"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "url_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 2, "maxLength": 50},
    "metadescription": {"type": "string", "minLength": 150, "maxLength": 160},
    "tagline": {"type": "string", "minLength": 15, "maxLength": 80},
    "history-content": {"type": "string", "minLength": 200},
    "history-events": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event-date", "event-name", "event-description"],
        "properties": {
          "event-date": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"},
          "event-name": {"type": "string", "minLength": 5, "maxLength": 100},
          "event-description": {"type": "string", "minLength": 50}
        }
      }
    }
  }
}
